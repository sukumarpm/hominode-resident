<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Native startup theme -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#06182B</item>
        <item name="android:navigationBarColor">#06182B</item>
    </style>

    <!-- Window while Flutter initializes -->
    <style name="NormalTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">#06182B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#06182B</item>
        <item name="android:navigationBarColor">#06182B</item>
    </style>

</resources>