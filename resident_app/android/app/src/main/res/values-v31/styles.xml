<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">

        <item name="android:windowSplashScreenBackground">#06182B</item>

        <item name="android:windowSplashScreenAnimatedIcon">
            @mipmap/ic_launcher
        </item>

        <item name="android:windowSplashScreenIconBackgroundColor">
            #06182B
        </item>

        <item name="android:windowSplashScreenAnimationDuration">
            300
        </item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#06182B</item>
        <item name="android:navigationBarColor">#06182B</item>

    </style>

    <style name="NormalTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">#06182B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#06182B</item>
        <item name="android:navigationBarColor">#06182B</item>
    </style>

</resources>
